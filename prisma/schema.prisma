// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum Category {
  TECH
  WORK
  FITNESS
  FOOD
  TRAVEL
  LIFE
}

//* ==========================================
//* 1. User
//* ==========================================

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String    
  currentStreak    Int       @default(0)
  lastActivityAt   DateTime? 
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  posts            Post[]

  @@map("users")
}

//* ==========================================
//* 2. Post & Content (Blog Core)
//* ==========================================

model Post {
  id          String        @id @default(uuid()) @db.Uuid
  authorId    String        @db.Uuid
  category    Category      
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  thumbnail String?
  
  //* Relations
  author      User          @relation(fields: [authorId], references: [id])
  contents    PostContent[]
  postTags    PostTag[]
  postMedia   PostMedia[]

  @@map("posts")
}

model PostContent {
  id             String      @id @default(uuid()) @db.Uuid
  postId         String      @db.Uuid
  locale         String      //* "ja" | "en"
  status         PostStatus  @default(DRAFT) 
  publishedAt    DateTime?
  isFeatured     Boolean     @default(false)
  title          String
  slug           String      @unique
  projectData    Json?
  html           String?     @db.Text
  seoTitle       String?
  seoDescription String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  //* Relations
  post           Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@map("post_contents")
}

//* ==========================================
//* 3. Taxonomy (Tags)
//* ==========================================

model Tag {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique 
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  
  //* Relations
  contents  TagContent[]
  tags      PostTag[]

  @@map("tags")
}

model TagContent {
  id        String   @id @default(uuid()) @db.Uuid
  tagId     String   @db.Uuid
  locale    String   //* "ja" | "en"
  name      String   //* 画面表示名 (例: 筋トレ, Workout)
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //* Relations
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@unique([locale, slug])
  @@map("tag_contents")
}

model PostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid

  //* Relations
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

//* ==========================================
//* 4. Media Management
//* ==========================================

model Media {
  id        String      @id @default(uuid()) @db.Uuid
  publicId  String      @unique 
  url       String      @db.Text
  mimeType  String
  width     Int?        
  height    Int?        
  fileSize  Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  //* Relations
  postMedia PostMedia[]

  @@map("media")
}

model PostMedia {
  postId  String @db.Uuid
  mediaId String @db.Uuid

  //* Relations
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId]) 
  @@map("post_media")
}