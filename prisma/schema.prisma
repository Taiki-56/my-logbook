// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
  PRIVATE
}

//* ==========================================
//* 1. User & Site Settings
//* ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   //* Credentials(ID/Pass)認証用
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  posts        Post[]

  @@map("users")
}

model SiteSetting {
  id              String   @id @default(uuid()) @db.Uuid
  siteName        String
  siteDescription String?  @db.Text
  profileImage    String?  @db.Text //* サイト全体の管理者画像として一本化
  githubUrl       String?  @db.Text
  xUrl            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

//* ==========================================
//* 2. Post & Content (Blog Core)
//* ==========================================

model Post {
  id          String        @id @default(uuid()) @db.Uuid
  authorId    String        @db.Uuid
  thumbnail   String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  //* Relations
  author      User          @relation(fields: [authorId], references: [id])
  contents    PostContent[]
  postTags    PostTag[]
  postMedia   PostMedia[]

  @@map("posts")
}

model PostContent {
  id             String      @id @default(uuid()) @db.Uuid
  postId         String      @db.Uuid
  locale         String      //* "ja" | "en" | "fr"
  status         PostStatus  @default(DRAFT) 
  publishedAt    DateTime?
  isFeatured     Boolean     @default(false) //* To display featured posts on /home page
  title          String
  slug           String
  projectData    Json?
  html           String?     @db.Text
  seoTitle       String?
  seoDescription String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  //* Relations
  post           Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@unique([locale, slug])
  @@map("post_contents")
}

//* ==========================================
//* 3. Taxonomy (Tags)
//* ==========================================

model Tag {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique //* 🌟 追加: 将来の共通識別子。今は入力された文字列をそのまま保存します。
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  
  //* Relations
  contents  TagContent[]
  tags      PostTag[]

  @@map("tags")
}

model TagContent {
  id        String   @id @default(uuid()) @db.Uuid
  tagId     String   @db.Uuid
  locale    String   //* "ja" | "en" | "fr"
  name      String   //* 画面表示名 (例: 筋トレ)
  slug      String   //* URL用 (例: workout)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //* Relations
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@unique([locale, slug])
  @@map("tag_contents")
}

model PostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid

  //* Relations
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId]) //* 複合主キー
  @@map("post_tags")
}

//* ==========================================
//* 4. Media Management
//* ==========================================

model Media {
  id        String      @id @default(uuid()) @db.Uuid
  publicId  String      @unique //* クラウドストレージ上の削除キー
  url       String      @db.Text
  mimeType  String
  width     Int?        //* Next.js <Image> の CLS 対策用
  height    Int?        //* Next.js <Image> の CLS 対策用
  fileSize  Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  //* Relations
  postMedia PostMedia[]

  @@map("media")
}

model PostMedia {
  postId  String @db.Uuid
  mediaId String @db.Uuid

  //* Relations
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId]) //* 複合主キー
  @@map("post_media")
}